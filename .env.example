# Copy to .env and fill in. .env is gitignored; never commit it.
# Colab (VS Code extension): right-click .env > "Upload to Colab"; the notebook reads /content/.env.

# Fine-grained GitHub token, read-only "Contents" access to ignoreandfly/implicit-adaptation
GITHUB_TOKEN=
# Optional: Hugging Face read token (faster model downloads)
HF_TOKEN=
